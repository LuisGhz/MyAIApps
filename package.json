{
  "name": "myaiapps",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:chat": "turbo run dev --filter=@myaiapps/chat-web --filter=@myaiapps/chat-api",
    "dev:english": "turbo run dev --filter=@myaiapps/english-web --filter=@myaiapps/english-api",
    "dev:imggen": "turbo run dev --filter=@myaiapps/imggen-web --filter=@myaiapps/imggen-api",
    "lint:chat": "turbo run lint --filter=@myaiapps/chat-web --filter=@myaiapps/chat-api",
    "lint:english": "turbo run lint --filter=@myaiapps/english-web --filter=@myaiapps/english-api",
    "lint:imggen": "turbo run lint --filter=@myaiapps/imggen-web --filter=@myaiapps/imggen-api",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "deploy": "turbo run build --affected"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
