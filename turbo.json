{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "remoteCache": {
    "enabled": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "tsconfig*.json"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@myaiapps/english-web#build": {
      "env": [
        "NG_APP_AUTH0_DOMAIN",
        "NG_APP_AUTH0_CLIENT_ID",
        "NG_APP_AUTH0_AUDIENCE"
      ]
    },
    "@myaiapps/imggen-web#build": {
      "env": [
        "VITE_API_URL",
        "VITE_AUTH0_DOMAIN",
        "VITE_AUTH0_CLIENT_ID",
        "VITE_AUTH0_AUDIENCE"
      ]
    }
  }
}
